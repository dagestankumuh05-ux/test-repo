# ==============================================================
# TELEGRAM BOT CONFIGURATION
# ==============================================================

# Токен Telegram-бота (получить у @BotFather: /newbot)
# Формат: 1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ123456789
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ID чата/канала для публикации
# Личные сообщения: числовой ID (получить у @userinfobot)
# Публичный канал:  @channel_name
# Приватный канал:  -1001234567890
# Группа:           -123456789
TELEGRAM_CHAT_ID=your_chat_id_here

# ==============================================================
# TWELVE DATA API
# ==============================================================

# API-ключ (получить на https://twelvedata.com/account/api-keys)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Дневной лимит API-кредитов вашего плана:
#   Free план:  800  (бот использует ~8/день — в рамках лимита)
#   Basic план: 55000
API_DAILY_QUOTA=800

# ==============================================================
# SCHEDULER
# ==============================================================

# Cron-выражение (формат: минута час * * *)
# Примеры:
#   0 7 * * *     = каждый день в 07:00 CET (по умолчанию)
#   0 7 * * 1-5   = только будни в 07:00 CET
#   0 7,19 * * *  = в 07:00 и 19:00 CET
CRON_EXPRESSION=0 7 * * *

# Временная зона cron (IANA timezone name)
# Список: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ_CRON=Europe/Amsterdam

# Отправить сводку СРАЗУ при запуске бота (для тестирования)
# true = немедленная отправка + работа по расписанию
# false = только по расписанию (по умолчанию)
RUN_ON_START=false

# ==============================================================
# HEALTH SERVER
# ==============================================================

# Включить HTTP health-endpoint на /health, /ready, /metrics
HEALTH_ENABLED=true

# Порт health-сервера (default: 3000)
HEALTH_PORT=3000

# ==============================================================
# API REQUEST SETTINGS
# ==============================================================

# Таймаут каждого HTTP-запроса в мс (default: 15000 = 15 сек)
API_TIMEOUT_MS=15000

# Количество повторных попыток при ошибке (default: 3)
API_RETRIES=3

# Начальная задержка между попытками в мс (default: 2000 = 2 сек)
# Используется exponential backoff: 2000 → 4000 → 8000
API_RETRY_DELAY_MS=2000

# ==============================================================
# LOGGING
# ==============================================================

# Уровень логирования: debug | info | warn | error
LOG_LEVEL=info

# Хранить логи за N дней (default: 14d)
LOG_MAX_FILES=14d

# Максимальный размер файла лога (default: 20m = 20 MB)
LOG_MAX_SIZE=20m

# ==============================================================
# APPLICATION
# ==============================================================

NODE_ENV=production
