# ============================================================
# Telegram Bot Configuration
# ============================================================

# Получить у @BotFather в Telegram (инструкция в README.md)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID канала/чата для публикации (инструкция в README.md)
# Для канала: -100XXXXXXXXXX
# Для личного чата: XXXXXXXXXX
TELEGRAM_CHAT_ID=your_chat_id_here

# ============================================================
# API Keys
# ============================================================

# Twelve Data API — https://twelvedata.com (бесплатный план: 800 запросов/день)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# ============================================================
# Scheduler Settings
# ============================================================

# Cron-выражение (по умолчанию: 07:00 ежедневно)
# Формат: минута час * * *
CRON_TIME=0 7 * * *

# Часовой пояс (CET/Europe Amsterdam)
TIMEZONE=Europe/Amsterdam

# ============================================================
# Optional: Logging
# ============================================================

# Уровень логирования: error | warn | info | debug
LOG_LEVEL=info

# Хранить логи N дней (по умолчанию: 14)
LOG_RETENTION_DAYS=14

# ============================================================
# Optional: Request Settings
# ============================================================

# Таймаут HTTP-запросов в мс (по умолчанию: 10000)
REQUEST_TIMEOUT_MS=10000

# Количество попыток при ошибке (по умолчанию: 3)
RETRY_ATTEMPTS=3
