# ==============================================================
# TELEGRAM BOT CONFIGURATION
# ==============================================================

# Токен вашего Telegram-бота (получить у @BotFather)
# Формат: 1234567890:AABBCCDDeeffGGHHIIjjKKllMMnnOOpp
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ID чата/канала для публикации сводки
# Для личных сообщений: ваш числовой ID (получить у @userinfobot)
# Для канала: @channel_username или числовой ID (-100xxxxxxxxx)
# Для группы: числовой ID (-xxxxxxxxx)
TELEGRAM_CHAT_ID=your_chat_id_here

# ==============================================================
# TWELVE DATA API CONFIGURATION
# ==============================================================

# API-ключ Twelve Data (получить на https://twelvedata.com/account/api-keys)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# ==============================================================
# SCHEDULER CONFIGURATION
# ==============================================================

# Cron-выражение для расписания (по умолчанию: 07:00 каждый день)
# Формат: минута час * * * (timezone задаётся отдельно)
CRON_EXPRESSION=0 7 * * *

# Запустить сводку сразу при старте бота (для тестирования)
# true = запустить немедленно, false = только по расписанию
RUN_ON_START=false

# ==============================================================
# ADVANCED SETTINGS (можно не менять)
# ==============================================================

# Таймаут API-запросов в миллисекундах (по умолчанию: 15000 = 15 сек)
API_TIMEOUT_MS=15000

# Количество попыток при ошибке API (по умолчанию: 3)
API_RETRIES=3

# Задержка между повторными попытками в мс (по умолчанию: 2000 = 2 сек)
API_RETRY_DELAY_MS=2000

# Уровень логирования: info | warn | error (по умолчанию: info)
LOG_LEVEL=info

# Окружение: production | development
NODE_ENV=production
